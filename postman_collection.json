{
  "info": {
    "name": "Accommodation Booking API",
    "description": "End-to-end smoke test for the accommodation ERD backend. Run requests in order. Set admin credentials in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8000"},
    {"key": "adminEmail", "value": "admin@example.com"},
    {"key": "adminPassword", "value": "ChangeMe123!"},
    {"key": "token", "value": ""},
    {"key": "countryId", "value": ""},
    {"key": "cityId", "value": ""},
    {"key": "guestId", "value": ""},
    {"key": "amenityId", "value": ""},
    {"key": "accommodationId", "value": ""},
    {"key": "reservationId", "value": ""},
    {"key": "paymentId", "value": ""}
  ],
  "item": [
    {"name":"1 - Health","request":{"method":"GET","url":"{{baseUrl}}/health"}},
    {"name":"2 - Admin login","event":[{"listen":"test","script":{"exec":["const data = pm.response.json();","pm.collectionVariables.set('token', data.access_token);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"},"url":"{{baseUrl}}/api/auth/admin/login"}},
    {"name":"3 - Create country","event":[{"listen":"test","script":{"exec":["pm.collectionVariables.set('countryId', pm.response.json().country_id);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\"name\":\"Iran\",\"latitude\":32.0,\"longitude\":53.0}"},"url":"{{baseUrl}}/api/countries"}},
    {"name":"4 - Create city","event":[{"listen":"test","script":{"exec":["pm.collectionVariables.set('cityId', pm.response.json().city_id);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\"country_id\":{{countryId}},\"name\":\"Tehran\"}"},"url":"{{baseUrl}}/api/cities"}},
    {"name":"5 - Create guest","event":[{"listen":"test","script":{"exec":["pm.collectionVariables.set('guestId', pm.response.json().guest_id);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"first_name\":\"Sara\",\"last_name\":\"Ahmadi\",\"email\":\"sara.{{$timestamp}}@example.com\",\"phone\":\"09{{$randomInt}}{{$randomInt}}{{$randomInt}}{{$randomInt}}{{$randomInt}}{{$randomInt}}\"}"},"url":"{{baseUrl}}/api/guests"}},
    {"name":"6 - Create amenity","event":[{"listen":"test","script":{"exec":["pm.collectionVariables.set('amenityId', pm.response.json().amenity_id);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\"name\":\"Wi-Fi\",\"category\":\"Connectivity\"}"},"url":"{{baseUrl}}/api/amenities"}},
    {"name":"7 - Create accommodation","event":[{"listen":"test","script":{"exec":["pm.collectionVariables.set('accommodationId', pm.response.json().accommodation_id);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\n  \"city_id\": {{cityId}},\n  \"title\": \"Garden Suite\",\n  \"address\": \"Tehran\",\n  \"type\": \"suite\",\n  \"capacity\": 3,\n  \"discount\": 0,\n  \"amenity_ids\": [{{amenityId}}],\n  \"images\": [{\"image_url\":\"https://example.com/room.jpg\",\"caption\":\"Main room\"}],\n  \"rules\": [{\"title\":\"No smoking\",\"description\":\"Smoking is not allowed\"}]\n}"},"url":"{{baseUrl}}/api/accommodations"}},
    {"name":"8a - Set first night price","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\"price_date\":\"2026-12-01\",\"price\":100,\"availability_status\":\"available\"}"},"url":"{{baseUrl}}/api/accommodations/{{accommodationId}}/prices"}},
    {"name":"8b - Set second night price","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\"price_date\":\"2026-12-02\",\"price\":120,\"availability_status\":\"available\"}"},"url":"{{baseUrl}}/api/accommodations/{{accommodationId}}/prices"}},
    {"name":"9 - Create reservation","event":[{"listen":"test","script":{"exec":["pm.collectionVariables.set('reservationId', pm.response.json().reservation_id);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"guest_id\":{{guestId}},\"accommodation_id\":{{accommodationId}},\"check_in_date\":\"2026-12-01\",\"check_out_date\":\"2026-12-03\",\"guest_count\":2}"},"url":"{{baseUrl}}/api/reservations"}},
    {"name":"10 - Create payment","event":[{"listen":"test","script":{"exec":["pm.collectionVariables.set('paymentId', pm.response.json().payment_id);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"reservation_id\":{{reservationId}},\"method\":\"mock\",\"tracking_code\":\"demo-{{$timestamp}}\"}"},"url":"{{baseUrl}}/api/payments"}},
    {"name":"11 - Simulate successful payment","request":{"method":"PATCH","url":"{{baseUrl}}/api/payments/{{paymentId}}/simulate-result?successful=true"}},
    {"name":"12 - Create rating","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"guest_id\":{{guestId}},\"accommodation_id\":{{accommodationId}},\"score\":5,\"comment\":\"Great stay\"}"},"url":"{{baseUrl}}/api/ratings"}},
    {"name":"13 - Add favorite","request":{"method":"POST","url":"{{baseUrl}}/api/guests/{{guestId}}/favorites/{{accommodationId}}"}},
    {"name":"14 - Search accommodations","request":{"method":"GET","url":"{{baseUrl}}/api/accommodations?city_id={{cityId}}&min_capacity=2"}}
  ]
}
